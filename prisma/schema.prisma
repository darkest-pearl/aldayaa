generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  status            String               @default("DEMO")
  type              String               @default("DEMO")
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  profiles          RestaurantProfile[]
  settings          RestaurantSettings[]
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  galleryCategories GalleryCategory[]
  photos            Photo[]
  announcements     Announcement[]
  tables            RestaurantTable[]
  reservations       Reservation[]
  orders             Order[]
  orderItems         OrderItem[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  menuItemIngredients MenuItemIngredient[]
  orderRecipeConsumptions OrderRecipeConsumption[]
}

model MenuCategory {
  id           String      @id @default(cuid())
  name         String
  description  String?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  items        MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id          String               @id @default(cuid())
  name        String
  description String?
  price       Float
  isAvailable Boolean              @default(true)
  imageUrl    String?
  recommended Boolean              @default(false)
  isSignature Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  restaurantId String?
  restaurant   Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  categoryId  String
  category    MenuCategory         @relation(fields: [categoryId], references: [id])
  orders      OrderItem[]
  ingredients MenuItemIngredient[]

  @@index([restaurantId])
  @@index([isSignature])
}

model GalleryCategory {
  id           String      @id @default(cuid())
  name         String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  photos       Photo[]

  @@index([restaurantId])
}

model Photo {
  id           String           @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  restaurantId String?
  restaurant   Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  categoryId   String
  category     GalleryCategory  @relation(fields: [categoryId], references: [id])

  @@index([restaurantId])
}

model Reservation {
  id              String      @id @default(cuid())
  name            String
  phone           String
  email           String?
  date            DateTime
  time            String
  guests          Int         @default(1)
  specialRequests String?
  status          String      @default("PENDING")
  reference       String      @unique
  createdAt       DateTime    @default(now())
  restaurantId    String?
  restaurant      Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
}

model Order {
  id                  String                   @id @default(cuid())
  name                String
  phone               String
  deliveryType        String
  address             String?
  notes               String?
  totalPrice          Float
  status              String                   @default("NEW")
  createdAt           DateTime                 @default(now())
  notifyWhenReady     Boolean                  @default(false)
  paidOnline          Boolean                  @default(false)
  reference           String                   @unique
  tableId             String?
  tableLabel          String?
  tableSlug           String?
  orderContext        String                   @default("STANDARD")
  createdByAdminId    String?
  createdByAdminEmail String?
  orderSource         String                   @default("CUSTOMER")
  restaurantId        String?
  restaurant          Restaurant?              @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  table               RestaurantTable?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  recipeConsumptions  OrderRecipeConsumption[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([orderContext])
  @@index([createdByAdminId])
  @@index([orderSource])
}

model OrderRecipeConsumption {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  appliedByAdminId    String?
  appliedByAdminEmail String?
  status              String   @default("APPLIED")
  notes               String?
  createdAt           DateTime @default(now())
  restaurantId        String?
  restaurant          Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@unique([orderId, status])
  @@index([restaurantId])
  @@index([orderId])
  @@index([createdAt])
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  itemId       String?
  name         String
  price        Float
  quantity     Int
  menuItemId   String?
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  MenuItem     MenuItem?   @relation(fields: [menuItemId], references: [id])
  order        Order       @relation(fields: [orderId], references: [id])

  @@index([restaurantId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  role         String   @default("ADMIN")
}

model RestaurantSettings {
  id                    Int     @id @default(1)
  openingTime           String
  closingTime           String
  allowCancelPaid       Boolean @default(false)
  allowCancelInProgress Boolean @default(false)
  cancellationFee       Float   @default(0)
  workingHoursByDay     String?
  displayHours          String?
  restaurantId          String?
  restaurant            Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
}

model RestaurantProfile {
  id                 Int      @id @default(1)
  restaurantName     String   @default("Demo Restaurant")
  tagline            String   @default("A configurable restaurant demo for modern digital operations.")
  cuisineType        String   @default("Demo cuisine")
  whatsappNumber     String   @default("+971 50 000 0000")
  whatsappLink       String   @default("https://wa.me/971500000000")
  address            String   @default("Demo Restaurant, Sharjah, UAE")
  googleMapsUrl      String   @default("https://www.google.com/maps/search/?api=1&query=Demo%20Restaurant%20Sharjah")
  googleMapsEmbedUrl String   @default("https://www.google.com/maps?output=embed&q=Demo%20Restaurant%20Sharjah")
  instagramUrl       String   @default("https://example.com/demo-restaurant/instagram")
  facebookUrl        String   @default("https://example.com/demo-restaurant/facebook")
  tiktokUrl          String   @default("https://example.com/demo-restaurant/tiktok")
  linktreeUrl        String   @default("https://example.com/demo-restaurant")
  logoUrl            String   @default("/images/food-mezze.jpg")
  primaryColor       String   @default("#d6b15f")
  secondaryColor     String   @default("#183b32")
  currency           String   @default("AED")
  enabledFeatures    String   @default("[\"WEBSITE\",\"MENU\",\"GALLERY\",\"RESERVATIONS\",\"ONLINE_ORDERING\",\"ANNOUNCEMENTS\",\"CONTACT_WHATSAPP\"]")
  restaurantId       String?
  restaurant         Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([restaurantId])
}

model RestaurantTable {
  id           String      @id @default(cuid())
  label        String
  slug         String      @unique
  qrToken      String      @unique
  seats        Int?
  zone         String?
  isActive     Boolean     @default(true)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([restaurantId])
  @@index([isActive])
  @@index([zone])
}

model InventoryItem {
  id                String               @id @default(cuid())
  name              String
  sku               String?              @unique
  category          String?
  unit              String
  currentStock      Float                @default(0)
  reorderLevel      Float?
  costPerUnit       Float?
  isActive          Boolean              @default(true)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  restaurantId      String?
  restaurant        Restaurant?          @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  movements         InventoryMovement[]
  recipeIngredients MenuItemIngredient[]

  @@index([restaurantId])
  @@index([name])
  @@index([category])
  @@index([isActive])
}

model MenuItemIngredient {
  id              String        @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Float
  unit            String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  restaurantId    String?
  restaurant      Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@unique([menuItemId, inventoryItemId])
  @@index([restaurantId])
  @@index([menuItemId])
  @@index([inventoryItemId])
}

model InventoryMovement {
  id                  String        @id @default(cuid())
  itemId              String
  item                InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type                String
  quantity            Float
  reason              String?
  source              String?
  createdByAdminId    String?
  createdByAdminEmail String?
  createdAt           DateTime      @default(now())
  restaurantId        String?
  restaurant          Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([restaurantId])
  @@index([type])
  @@index([createdAt])
}

model Announcement {
  id           String      @id @default(cuid())
  message      String
  isActive     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
}

model GatewayLead {
  id                String    @id @default(cuid())
  restaurantName    String
  contactName       String
  phone             String
  email             String?
  interestedModules String?
  message           String?
  internalNotes     String?
  status            String    @default("NEW")
  lastContactedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([lastContactedAt])
}
